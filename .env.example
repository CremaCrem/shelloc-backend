# SHELLOC Backend — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored. Never commit real secrets.

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=shelloc

# Robot authentication
# The robot sends this in the X-API-Key header on write endpoints.
# Generate a strong random value (e.g.: openssl rand -hex 32)
API_KEY=your-secret-api-key-here

# AI provider — one of: openai, claude, gemini
AI_PROVIDER=openai

# API key for the chosen AI provider
AI_API_KEY=your-ai-provider-api-key-here
